<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>aspnet-PaymentsApi-f618502b-ea33-46a1-a8ab-b24178d55704</UserSecretsId>
        <InvariantGlobalization>true</InvariantGlobalization>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

        <!-- DEMO: use noble-chiseled base for locked down image -->
		<!--
		<ContainerFamily>noble-chiseled</ContainerFamily>
		<ContainerUser>app</ContainerUser>
		-->
        <!-- Azure.Data.Tables uses reflection-based entity binding and isn't fully trim-compatible. -->
        <!--<TrimMode>partial</TrimMode>-->

	</PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" NoWarn="NU1605" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
        <PackageReference Include="Azure.Storage.Queues" Version="12.28.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
        <ProjectReference Include="..\Models\Models.csproj" />
        <ProjectReference Include="..\MiniBank.ServiceDefaults\MiniBank.ServiceDefaults.csproj" />
    </ItemGroup>

</Project>
